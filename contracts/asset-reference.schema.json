{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["asset_id", "version"],
    "properties": {
        "asset_id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$", "maxLength": 64 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "maxLength": 32 }
    }
}
