{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://toon.local/contracts/character-recipe.schema.json",
    "type": "object",
    "additionalProperties": false,
    "required": ["schema_version", "rig", "missing_details", "generated_details", "notes"],
    "properties": {
        "schema_version": {
            "const": "1.0.0"
        },
        "rig": {
            "$ref": "#/$defs/rig"
        },
        "missing_details": {
            "type": "array",
            "maxItems": 64,
            "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
            }
        },
        "generated_details": {
            "type": "array",
            "maxItems": 64,
            "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
            }
        },
        "notes": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
        }
    },
    "$defs": {
        "rig": {
            "type": "object",
            "additionalProperties": false,
            "required": ["schema_version", "name", "canvas", "poses", "emotions", "gestures", "motion", "layers"],
            "properties": {
                "schema_version": {
                    "const": "1.0.0"
                },
                "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                },
                "canvas": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["width", "height"],
                    "properties": {
                        "width": {
                            "const": 380
                        },
                        "height": {
                            "const": 560
                        }
                    }
                },
                "poses": {
                    "const": ["seated"]
                },
                "emotions": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 32,
                    "uniqueItems": true,
                    "items": {
                        "enum": ["neutral", "concerned", "annoyed", "surprised", "confident", "pleased"]
                    }
                },
                "gestures": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["idle", "blink", "nod", "shake_head", "raise_hand", "shrug", "show_phone"],
                    "properties": {
                        "idle": {
                            "type": "integer",
                            "minimum": 8,
                            "maximum": 180
                        },
                        "blink": {
                            "type": "integer",
                            "minimum": 8,
                            "maximum": 180
                        },
                        "nod": {
                            "type": "integer",
                            "minimum": 8,
                            "maximum": 180
                        },
                        "shake_head": {
                            "type": "integer",
                            "minimum": 8,
                            "maximum": 180
                        },
                        "raise_hand": {
                            "type": "integer",
                            "minimum": 8,
                            "maximum": 180
                        },
                        "shrug": {
                            "type": "integer",
                            "minimum": 8,
                            "maximum": 180
                        },
                        "show_phone": {
                            "type": "integer",
                            "minimum": 8,
                            "maximum": 180
                        }
                    }
                },
                "motion": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "blink_phase",
                        "blink_period",
                        "head_phase",
                        "body_phase",
                        "head_angles",
                        "left_arm",
                        "right_arm"
                    ],
                    "properties": {
                        "blink_phase": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 200
                        },
                        "blink_period": {
                            "type": "integer",
                            "minimum": 30,
                            "maximum": 300
                        },
                        "head_phase": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 200
                        },
                        "body_phase": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 200
                        },
                        "head_angles": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "neutral": {
                                    "type": "number",
                                    "minimum": -10,
                                    "maximum": 10
                                },
                                "concerned": {
                                    "type": "number",
                                    "minimum": -10,
                                    "maximum": 10
                                },
                                "annoyed": {
                                    "type": "number",
                                    "minimum": -10,
                                    "maximum": 10
                                },
                                "surprised": {
                                    "type": "number",
                                    "minimum": -10,
                                    "maximum": 10
                                },
                                "confident": {
                                    "type": "number",
                                    "minimum": -10,
                                    "maximum": 10
                                },
                                "pleased": {
                                    "type": "number",
                                    "minimum": -10,
                                    "maximum": 10
                                }
                            }
                        },
                        "left_arm": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "idle": {
                                    "type": "number",
                                    "minimum": -90,
                                    "maximum": 90
                                },
                                "blink": {
                                    "type": "number",
                                    "minimum": -90,
                                    "maximum": 90
                                },
                                "nod": {
                                    "type": "number",
                                    "minimum": -90,
                                    "maximum": 90
                                },
                                "shake_head": {
                                    "type": "number",
                                    "minimum": -90,
                                    "maximum": 90
                                },
                                "raise_hand": {
                                    "type": "number",
                                    "minimum": -90,
                                    "maximum": 90
                                },
                                "shrug": {
                                    "type": "number",
                                    "minimum": -90,
                                    "maximum": 90
                                },
                                "show_phone": {
                                    "type": "number",
                                    "minimum": -90,
                                    "maximum": 90
                                }
                            }
                        },
                        "right_arm": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "idle": {
                                    "type": "number",
                                    "minimum": -90,
                                    "maximum": 90
                                },
                                "blink": {
                                    "type": "number",
                                    "minimum": -90,
                                    "maximum": 90
                                },
                                "nod": {
                                    "type": "number",
                                    "minimum": -90,
                                    "maximum": 90
                                },
                                "shake_head": {
                                    "type": "number",
                                    "minimum": -90,
                                    "maximum": 90
                                },
                                "raise_hand": {
                                    "type": "number",
                                    "minimum": -90,
                                    "maximum": 90
                                },
                                "shrug": {
                                    "type": "number",
                                    "minimum": -90,
                                    "maximum": 90
                                },
                                "show_phone": {
                                    "type": "number",
                                    "minimum": -90,
                                    "maximum": 90
                                }
                            }
                        }
                    }
                },
                "layers": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 128,
                    "items": {
                        "$ref": "#/$defs/node"
                    }
                }
            }
        },
        "node": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type"],
            "properties": {
                "type": {
                    "enum": ["group", "path", "ellipse", "circle", "rect", "cutout"]
                },
                "props": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [],
                    "properties": {
                        "x": {
                            "type": "number",
                            "minimum": -8192,
                            "maximum": 8192
                        },
                        "y": {
                            "type": "number",
                            "minimum": -8192,
                            "maximum": 8192
                        },
                        "cx": {
                            "type": "number",
                            "minimum": -8192,
                            "maximum": 8192
                        },
                        "cy": {
                            "type": "number",
                            "minimum": -8192,
                            "maximum": 8192
                        },
                        "r": {
                            "type": "number",
                            "minimum": -8192,
                            "maximum": 8192
                        },
                        "rx": {
                            "type": "number",
                            "minimum": -8192,
                            "maximum": 8192
                        },
                        "ry": {
                            "type": "number",
                            "minimum": -8192,
                            "maximum": 8192
                        },
                        "width": {
                            "type": "number",
                            "minimum": -8192,
                            "maximum": 8192
                        },
                        "height": {
                            "type": "number",
                            "minimum": -8192,
                            "maximum": 8192
                        },
                        "strokeWidth": {
                            "type": "number",
                            "minimum": -8192,
                            "maximum": 8192
                        },
                        "opacity": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                        },
                        "fill": {
                            "type": "string",
                            "pattern": "^(none|#[0-9a-fA-F]{3}|#[0-9a-fA-F]{6})$"
                        },
                        "stroke": {
                            "type": "string",
                            "pattern": "^(none|#[0-9a-fA-F]{3}|#[0-9a-fA-F]{6})$"
                        },
                        "strokeLinecap": {
                            "enum": ["round", "butt", "square"]
                        },
                        "strokeLinejoin": {
                            "enum": ["round", "miter", "bevel"]
                        },
                        "d": {
                            "type": "string",
                            "maxLength": 8192,
                            "pattern": "^[MmLlHhVvCcSsQqTtAaZz0-9eE+., \\-]+$"
                        },
                        "transform": {
                            "type": "string",
                            "maxLength": 200,
                            "pattern": "^((translate|rotate|scale)\\([0-9+., \\-]+\\) *)+$"
                        }
                    }
                },
                "children": {
                    "type": "array",
                    "maxItems": 256,
                    "items": {
                        "$ref": "#/$defs/node"
                    }
                },
                "motion": {
                    "enum": ["head", "left_arm", "right_arm"]
                },
                "pivot": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                        "type": "number",
                        "minimum": -8192,
                        "maximum": 8192
                    }
                },
                "when": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [],
                    "properties": {
                        "emotion": {
                            "type": "array",
                            "minItems": 1,
                            "maxItems": 32,
                            "uniqueItems": true,
                            "items": {
                                "enum": ["neutral", "concerned", "annoyed", "surprised", "confident", "pleased"]
                            }
                        },
                        "mouth": {
                            "type": "array",
                            "minItems": 1,
                            "maxItems": 4,
                            "uniqueItems": true,
                            "items": {
                                "enum": [0, 1, 2, 3]
                            }
                        },
                        "blink": {
                            "type": "boolean"
                        },
                        "phone": {
                            "type": "boolean"
                        }
                    }
                },
                "source_role": {
                    "enum": ["front", "three_quarter", "expressions", "hands", "mouths", "pose_reference"]
                },
                "asset": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["asset_id", "version"],
                    "properties": {
                        "asset_id": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9_-]+$",
                            "maxLength": 100
                        },
                        "version": {
                            "type": "string",
                            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
                        }
                    }
                },
                "source_width": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 8192
                },
                "source_height": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 8192
                },
                "polygon": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 128,
                    "items": {
                        "type": "array",
                        "minItems": 2,
                        "maxItems": 2,
                        "items": {
                            "type": "number",
                            "minimum": -8192,
                            "maximum": 8192
                        }
                    }
                },
                "box": {
                    "type": "array",
                    "minItems": 4,
                    "maxItems": 4,
                    "items": {
                        "type": "number",
                        "minimum": -8192,
                        "maximum": 8192
                    }
                },
                "target": {
                    "type": "array",
                    "minItems": 4,
                    "maxItems": 4,
                    "items": {
                        "type": "number",
                        "minimum": -8192,
                        "maximum": 8192
                    }
                }
            }
        }
    }
}
