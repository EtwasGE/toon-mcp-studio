{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://toon.local/contracts/environment-recipe.schema.json",
    "type": "object",
    "additionalProperties": false,
    "required": ["schema_version", "environment", "missing_details", "generated_details", "notes"],
    "properties": {
        "schema_version": {
            "const": "1.0.0"
        },
        "environment": {
            "$ref": "#/$defs/environment"
        },
        "missing_details": {
            "type": "array",
            "maxItems": 64,
            "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
            }
        },
        "generated_details": {
            "type": "array",
            "maxItems": 64,
            "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
            }
        },
        "notes": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
        }
    },
    "$defs": {
        "environment": {
            "type": "object",
            "additionalProperties": false,
            "required": ["schema_version", "name", "canvas", "slots", "anchors", "cameras", "layers"],
            "properties": {
                "schema_version": {
                    "const": "1.0.0"
                },
                "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                },
                "canvas": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["width", "height"],
                    "properties": {
                        "width": {
                            "const": 1080
                        },
                        "height": {
                            "const": 1920
                        }
                    }
                },
                "slots": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["left", "right", "center"],
                    "properties": {
                        "left": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": ["x", "floor_y", "scale", "depth", "focus"],
                            "properties": {
                                "x": {
                                    "type": "number",
                                    "minimum": 0,
                                    "maximum": 1080
                                },
                                "floor_y": {
                                    "type": "number",
                                    "minimum": 0,
                                    "maximum": 1920
                                },
                                "scale": {
                                    "type": "number",
                                    "minimum": 0.5,
                                    "maximum": 2
                                },
                                "depth": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 1000
                                },
                                "focus": {
                                    "type": "array",
                                    "minItems": 2,
                                    "maxItems": 2,
                                    "items": {
                                        "type": "number",
                                        "minimum": -8192,
                                        "maximum": 8192
                                    }
                                }
                            }
                        },
                        "right": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": ["x", "floor_y", "scale", "depth", "focus"],
                            "properties": {
                                "x": {
                                    "type": "number",
                                    "minimum": 0,
                                    "maximum": 1080
                                },
                                "floor_y": {
                                    "type": "number",
                                    "minimum": 0,
                                    "maximum": 1920
                                },
                                "scale": {
                                    "type": "number",
                                    "minimum": 0.5,
                                    "maximum": 2
                                },
                                "depth": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 1000
                                },
                                "focus": {
                                    "type": "array",
                                    "minItems": 2,
                                    "maxItems": 2,
                                    "items": {
                                        "type": "number",
                                        "minimum": -8192,
                                        "maximum": 8192
                                    }
                                }
                            }
                        },
                        "center": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": ["x", "floor_y", "scale", "depth", "focus"],
                            "properties": {
                                "x": {
                                    "type": "number",
                                    "minimum": 0,
                                    "maximum": 1080
                                },
                                "floor_y": {
                                    "type": "number",
                                    "minimum": 0,
                                    "maximum": 1920
                                },
                                "scale": {
                                    "type": "number",
                                    "minimum": 0.5,
                                    "maximum": 2
                                },
                                "depth": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 1000
                                },
                                "focus": {
                                    "type": "array",
                                    "minItems": 2,
                                    "maxItems": 2,
                                    "items": {
                                        "type": "number",
                                        "minimum": -8192,
                                        "maximum": 8192
                                    }
                                }
                            }
                        }
                    }
                },
                "anchors": {
                    "type": "object",
                    "maxProperties": 32,
                    "propertyNames": {
                        "pattern": "^[a-z][a-z0-9_-]{0,40}$"
                    },
                    "additionalProperties": {
                        "type": "array",
                        "minItems": 2,
                        "maxItems": 2,
                        "items": {
                            "type": "number",
                            "minimum": -8192,
                            "maximum": 8192
                        }
                    }
                },
                "cameras": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["wide", "two_shot", "screen", "close_up"],
                    "properties": {
                        "wide": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": ["scale", "x", "y"],
                            "properties": {
                                "scale": {
                                    "type": "number",
                                    "minimum": 1,
                                    "maximum": 2.5
                                },
                                "x": {
                                    "type": "number",
                                    "minimum": -8192,
                                    "maximum": 8192
                                },
                                "y": {
                                    "type": "number",
                                    "minimum": -8192,
                                    "maximum": 8192
                                }
                            }
                        },
                        "two_shot": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": ["scale", "x", "y"],
                            "properties": {
                                "scale": {
                                    "type": "number",
                                    "minimum": 1,
                                    "maximum": 2.5
                                },
                                "x": {
                                    "type": "number",
                                    "minimum": -8192,
                                    "maximum": 8192
                                },
                                "y": {
                                    "type": "number",
                                    "minimum": -8192,
                                    "maximum": 8192
                                }
                            }
                        },
                        "screen": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": ["scale", "x", "y"],
                            "properties": {
                                "scale": {
                                    "type": "number",
                                    "minimum": 1,
                                    "maximum": 2.5
                                },
                                "x": {
                                    "type": "number",
                                    "minimum": -8192,
                                    "maximum": 8192
                                },
                                "y": {
                                    "type": "number",
                                    "minimum": -8192,
                                    "maximum": 8192
                                }
                            }
                        },
                        "close_up": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": ["scale", "screen_anchor", "clamp"],
                            "properties": {
                                "scale": {
                                    "type": "number",
                                    "minimum": 1,
                                    "maximum": 2.5
                                },
                                "screen_anchor": {
                                    "type": "array",
                                    "minItems": 2,
                                    "maxItems": 2,
                                    "items": {
                                        "type": "number",
                                        "minimum": -8192,
                                        "maximum": 8192
                                    }
                                },
                                "clamp": {
                                    "type": "boolean"
                                }
                            }
                        }
                    }
                },
                "layers": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 32,
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["id", "depth", "space", "requires_cast", "nodes"],
                        "properties": {
                            "id": {
                                "type": "string",
                                "pattern": "^[a-z][a-z0-9_-]{0,40}$"
                            },
                            "depth": {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 1000
                            },
                            "space": {
                                "enum": ["world", "screen"]
                            },
                            "requires_cast": {
                                "type": "boolean"
                            },
                            "nodes": {
                                "type": "array",
                                "minItems": 1,
                                "maxItems": 128,
                                "items": {
                                    "$ref": "#/$defs/node"
                                }
                            }
                        }
                    }
                }
            }
        },
        "node": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type"],
            "properties": {
                "type": {
                    "enum": [
                        "group",
                        "path",
                        "ellipse",
                        "circle",
                        "rect",
                        "cutout",
                        "defs",
                        "pattern",
                        "linearGradient",
                        "stop"
                    ]
                },
                "props": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [],
                    "properties": {
                        "x": {
                            "type": "number",
                            "minimum": -8192,
                            "maximum": 8192
                        },
                        "y": {
                            "type": "number",
                            "minimum": -8192,
                            "maximum": 8192
                        },
                        "cx": {
                            "type": "number",
                            "minimum": -8192,
                            "maximum": 8192
                        },
                        "cy": {
                            "type": "number",
                            "minimum": -8192,
                            "maximum": 8192
                        },
                        "r": {
                            "type": "number",
                            "minimum": -8192,
                            "maximum": 8192
                        },
                        "rx": {
                            "type": "number",
                            "minimum": -8192,
                            "maximum": 8192
                        },
                        "ry": {
                            "type": "number",
                            "minimum": -8192,
                            "maximum": 8192
                        },
                        "width": {
                            "type": "number",
                            "minimum": -8192,
                            "maximum": 8192
                        },
                        "height": {
                            "type": "number",
                            "minimum": -8192,
                            "maximum": 8192
                        },
                        "strokeWidth": {
                            "type": "number",
                            "minimum": -8192,
                            "maximum": 8192
                        },
                        "opacity": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                        },
                        "fill": {
                            "type": "string",
                            "pattern": "^(none|#[0-9a-fA-F]{3}|#[0-9a-fA-F]{6}|url\\(#[a-z][a-z0-9_-]{0,40}\\))$"
                        },
                        "stroke": {
                            "type": "string",
                            "pattern": "^(none|#[0-9a-fA-F]{3}|#[0-9a-fA-F]{6})$"
                        },
                        "strokeLinecap": {
                            "enum": ["round", "butt", "square"]
                        },
                        "strokeLinejoin": {
                            "enum": ["round", "miter", "bevel"]
                        },
                        "d": {
                            "type": "string",
                            "maxLength": 8192,
                            "pattern": "^[MmLlHhVvCcSsQqTtAaZz0-9eE+., \\-]+$"
                        },
                        "transform": {
                            "type": "string",
                            "maxLength": 200,
                            "pattern": "^((translate|rotate|scale)\\([0-9+., \\-]+\\) *)+$"
                        },
                        "id": {
                            "type": "string",
                            "pattern": "^[a-z][a-z0-9_-]{0,40}$"
                        },
                        "stopColor": {
                            "type": "string",
                            "pattern": "^#[0-9a-fA-F]{6}$"
                        },
                        "offset": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                        },
                        "patternUnits": {
                            "enum": ["userSpaceOnUse"]
                        },
                        "x1": {
                            "type": "number",
                            "minimum": -8192,
                            "maximum": 8192
                        },
                        "x2": {
                            "type": "number",
                            "minimum": -8192,
                            "maximum": 8192
                        },
                        "y1": {
                            "type": "number",
                            "minimum": -8192,
                            "maximum": 8192
                        },
                        "y2": {
                            "type": "number",
                            "minimum": -8192,
                            "maximum": 8192
                        }
                    }
                },
                "children": {
                    "type": "array",
                    "maxItems": 256,
                    "items": {
                        "$ref": "#/$defs/node"
                    }
                },
                "source_role": {
                    "enum": ["wide", "layout", "foreground", "detail"]
                },
                "asset": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["asset_id", "version"],
                    "properties": {
                        "asset_id": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9_-]+$",
                            "maxLength": 100
                        },
                        "version": {
                            "type": "string",
                            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
                        }
                    }
                },
                "source_width": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 8192
                },
                "source_height": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 8192
                },
                "polygon": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 128,
                    "items": {
                        "type": "array",
                        "minItems": 2,
                        "maxItems": 2,
                        "items": {
                            "type": "number",
                            "minimum": -8192,
                            "maximum": 8192
                        }
                    }
                },
                "box": {
                    "type": "array",
                    "minItems": 4,
                    "maxItems": 4,
                    "items": {
                        "type": "number",
                        "minimum": -8192,
                        "maximum": 8192
                    }
                },
                "target": {
                    "type": "array",
                    "minItems": 4,
                    "maxItems": 4,
                    "items": {
                        "type": "number",
                        "minimum": -8192,
                        "maximum": 8192
                    }
                }
            }
        }
    }
}
