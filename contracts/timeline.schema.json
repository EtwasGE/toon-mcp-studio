{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:toon-mcp:schema:compiled-timeline:1.0.0",
    "type": "object",
    "required": [
        "schema_version",
        "renderer_version",
        "normalizer_version",
        "project_id",
        "revision",
        "fps",
        "width",
        "height",
        "total_frames",
        "total_samples",
        "sample_rate",
        "seed",
        "mouth_mode",
        "scenes",
        "utterances",
        "captions"
    ],
    "properties": {
        "schema_version": { "const": "1.0.0" },
        "renderer_version": { "type": "string" },
        "normalizer_version": { "const": "1.0.0" },
        "project_id": { "type": "string" },
        "revision": { "type": "integer", "minimum": 1 },
        "fps": { "const": 30 },
        "width": { "const": 1080 },
        "height": { "const": 1920 },
        "total_frames": { "type": "integer", "minimum": 1, "maximum": 1800 },
        "total_samples": { "type": "integer", "minimum": 1, "maximum": 2880000 },
        "sample_rate": { "const": 48000 },
        "seed": { "type": "integer" },
        "mouth_mode": { "const": "approximate/amplitude" },
        "scenes": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "required": [
                    "scene_id",
                    "start_frame",
                    "end_frame_exclusive",
                    "background",
                    "camera",
                    "cast",
                    "events",
                    "overlays"
                ],
                "properties": {
                    "start_frame": { "$ref": "#/$defs/frame" },
                    "end_frame_exclusive": { "$ref": "#/$defs/frame" },
                    "events": {
                        "type": "array",
                        "items": { "type": "object", "required": ["event_id", "frame", "action"] }
                    },
                    "overlays": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "required": ["overlay_id", "start_frame", "end_frame_exclusive", "content"]
                        }
                    }
                }
            }
        },
        "utterances": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "utterance_id",
                    "speaker_character_id",
                    "text",
                    "start_sample",
                    "end_sample_exclusive",
                    "start_frame",
                    "end_frame_exclusive",
                    "duration_ms",
                    "audio_hash",
                    "audio_file",
                    "envelope"
                ],
                "properties": {
                    "start_sample": { "type": "integer", "minimum": 0 },
                    "end_sample_exclusive": { "type": "integer", "minimum": 1 },
                    "audio_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                    "envelope": { "type": "array", "items": { "type": "number", "minimum": 0, "maximum": 1 } }
                }
            }
        },
        "captions": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["text", "start_frame", "end_frame_exclusive", "mode", "rect", "font_size"],
                "properties": {
                    "mode": { "enum": ["utterance", "phrase", "word"] },
                    "font_size": { "type": "integer", "minimum": 36 },
                    "start_frame": { "$ref": "#/$defs/frame" },
                    "end_frame_exclusive": { "$ref": "#/$defs/frame" }
                }
            }
        },
        "assets": { "type": "object", "additionalProperties": { "type": "string" } },
        "rigs": { "type": "object", "additionalProperties": { "type": "object" } },
        "environments": { "type": "object", "additionalProperties": { "type": "object" } }
    },
    "$defs": { "frame": { "type": "integer", "minimum": 0, "maximum": 1800 } }
}
