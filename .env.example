TOON_APP_ROOT=
TOON_DATA_ROOT=
TOON_IMPORT_ROOTS=
TOON_NODE=
TOON_FFMPEG=
TOON_FFPROBE=
TOON_LEASE_SECONDS=
TOON_HEARTBEAT_SECONDS=
TOON_MAX_MEDIA_BYTES=
TOON_MAX_ALIGNMENT_BYTES=
TOON_MAX_IMAGE_PIXELS=
TOON_MAX_AUDIO_SECONDS=
TOON_MAX_TTS_CHARACTERS=
# Voice cloning is off unless explicitly enabled; budget counts all dispatched requests in this data root.
TOON_ALLOW_VOICE_CLONING=0
TOON_MAX_VOICE_CLONES=0
TOON_VOICE_ALIASES=
# Optional override for the shared .NET User Secrets value.
ELEVENLABS_API_KEY=
# Set to 0 to disable User Secrets (offline tests and environment-only installations).
TOON_USE_USER_SECRETS=1

# Maximum seconds per new SFX job; explicit job authorization is also required.
TOON_MAX_SFX_SECONDS=10
